local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- 기존 스토리지 문제 해결을 위해 PlayerGui 사용
local storage = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui")
local FOLDER_NAME = "ESP_BOX_TEST"
if storage:FindFirstChild(FOLDER_NAME) then storage:FindFirstChild(FOLDER_NAME):Destroy() end
local folder = Instance.new("Folder")
folder.Name = FOLDER_NAME
folder.Parent = storage

local objects = {}

local function create(player)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(0, 100, 0, 150) -- 고정 크기 테스트
    holder.Position = UDim2.new(0.5, 0, 0.5, 0) -- 화면 정중앙 테스트
    holder.BackgroundTransparency = 0.5
    holder.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- 빨간색 박스로 강제 표시
    holder.Parent = folder
    objects[player] = { holder = holder }
    return objects[player]
end

Players.PlayerRemoving:Connect(function(player)
    if objects[player] then
        objects[player].holder:Destroy()
        objects[player] = nil
    end
end)

-- 강제 렌더링 루프 테스트
RunService.RenderStepped:Connect(function()
    for _, player in Players:GetPlayers() do
        if player == LocalPlayer then continue end
        local data = objects[player] or create(player)
        
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local root = character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                data.holder.Visible = true
                data.holder.Position = UDim2.new(0, screenPos.X - 50, 0, screenPos.Y - 75)
            else
                data.holder.Visible = false
            end
        else
            data.holder.Visible = false
        end
    end
end)

print("[ESP] Test box loaded successfully")
